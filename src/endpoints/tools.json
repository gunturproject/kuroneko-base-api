[
  {
    "name": "Short URL",
    "endpoint": "/api/tools/shorturl",
    "filename": "shorturl",
    "method": "GET",
    "params": [
      {
        "name": "url",
        "required": true,
        "description": "Original URL"
      },
      {
        "name": "alias",
        "required": false,
        "description": "Custom Alias"
      }
    ]
  },
  {
    "name": "WeAreDevs Lua Obfuscator",
    "endpoint": "/api/tools/obfuscate",
    "filename": "wearedevsObfuscate",
    "method": "POST",
    "params": [
      {
        "name": "script",
        "required": false,
        "description": "Kode Lua/Luau langsung (JSON body). Praktis sampai ~4,5 MB di Vercel; lebih besar pakai 'url'."
      },
      {
        "name": "url",
        "required": false,
        "description": "Alternatif untuk script besar: URL HTTPS file script di files.catbox.moe / litterbox.catbox.moe, maks 30 MB. Upload dulu dari client/server-mu, lalu kirim URL-nya."
      }
    ]
  },
  {
    "name": "Catbox Image Upscaler",
    "endpoint": "/api/tools/catbox-upscale",
    "filename": "catboxUpscale",
    "method": "GET",
    "params": [
      {
        "name": "url",
        "required": true,
        "description": "Link gambar Catbox (files.catbox.moe)"
      },
      {
        "name": "scale",
        "required": false,
        "description": "Skala pembesaran 1-8 (default 2, maks 34 MP / 8192px). Mengembalikan file gambar hasil langsung."
      },
      {
        "name": "format",
        "required": false,
        "description": "Format output: webp (default), jpeg, atau png"
      },
      {
        "name": "detail",
        "required": false,
        "description": "Tingkat ketajaman 0-1 (default 0.6)"
      }
    ]
  },
  {
    "name": "Gofile Scraper",
    "endpoint": "/api/tools/gofile",
    "filename": "gofile",
    "method": "GET",
    "params": [
      {
        "name": "url",
        "required": false,
        "description": "URL folder/file Gofile (https://gofile.io/d/KODE). Alternatif pakai 'code'."
      },
      {
        "name": "code",
        "required": false,
        "description": "Kode share Gofile (6-64 karakter) atau UUID konten."
      },
      {
        "name": "page",
        "required": false,
        "description": "Halaman listing, 1-1000 (default 1)."
      },
      {
        "name": "filter",
        "required": false,
        "description": "Filter nama file (maks 80 karakter)."
      },
      {
        "name": "compact",
        "required": false,
        "description": "1/true untuk respons ringkas (maks 5 item)."
      }
    ]
  }
]