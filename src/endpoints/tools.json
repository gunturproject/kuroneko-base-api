[
  {
    "name": "Short URL",
    "endpoint": "/api/tools/shorturl",
    "filename": "shorturl",
    "method": "GET",
    "params": [
      {
        "name": "url",
        "required": true,
        "description": "Original URL"
      },
      {
        "name": "alias",
        "required": false,
        "description": "Custom Alias"
      }
    ]
  },
  {
    "name": "WeAreDevs Lua Obfuscator",
    "endpoint": "/api/tools/obfuscate",
    "filename": "wearedevsObfuscate",
    "method": "POST",
    "params": [
      {
        "name": "script",
        "required": true,
        "description": "Kode Lua/Luau yang akan di-obfuscasi (JSON body: { \"script\": \"...\" }, maks 30 MB)"
      }
    ]
  },
  {
    "name": "Catbox Image Upscaler",
    "endpoint": "/api/tools/catbox-upscale",
    "filename": "catboxUpscale",
    "method": "GET",
    "params": [
      {
        "name": "url",
        "required": true,
        "description": "Link gambar Catbox (files.catbox.moe)"
      },
      {
        "name": "scale",
        "required": false,
        "description": "Skala pembesaran 1-8 (default 2, maks 34 MP / 8192px). Mengembalikan file gambar hasil langsung."
      },
      {
        "name": "format",
        "required": false,
        "description": "Format output: webp (default), jpeg, atau png"
      },
      {
        "name": "detail",
        "required": false,
        "description": "Tingkat ketajaman 0-1 (default 0.6)"
      }
    ]
  }
]