{
  "version": 2,
  "builds": [
    {
      "src": "index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/config.json",
          "public/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/src/(.*)",
      "dest": "index.ts"
    },
    {
      "src": "/config",
      "dest": "/public/config.json"
    },
    {
      "src": "/",
      "dest": "/public/landing/landing.html"
    },
    {
      "src": "/docs/?",
      "dest": "/public/docs/docs.html"
    },
    {
      "src": "/stats/?",
      "dest": "/public/stats/stats.html"
    },
    {
      "src": "/upscale/?",
      "dest": "/public/upscale/upscale.html"
    },
    {
      "src": "/404.html",
      "dest": "/public/404.html"
    },
    {
      "src": "/(.*\\.(?:css|js|mjs|json|jpg|jpeg|png|gif|svg|webp|ico|woff2?|ttf|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.ts"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/landing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/stats/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/upscale/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
